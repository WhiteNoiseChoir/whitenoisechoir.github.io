{
  "$schema": "https://developers.cloudflare.com/workers/wrangler/config-schema.json",
  "name": "whitenoisechoir-downloads",
  "main": "worker.mjs",
  "compatibility_date": "2026-11-11",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "downloads.whitenoisechoir.com",
      "custom_domain": true
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "whitenoisechoir-media"
    }
  ]
}
